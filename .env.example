# Security
CRON_SECRET=replace-with-long-random-string
ADMIN_API_TOKEN=replace-with-long-random-string
ADMIN_TELEGRAM_CHAT_ID=

# Public app URL override (optional; if empty VERCEL_URL is used)
APP_BASE_URL=

# Upstash Redis (preferred on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis Cloud / Redis URL (alternative)
REDIS_URL=

# Alternative Vercel KV env names (optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional, only for telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string

# Ops/self-heal knobs
MONTHLY_API_LIMIT=100000
API_USAGE_ALERT_THRESHOLD=0.8
OPS_SNAPSHOT_STALE_DAYS=2
OPS_TELEGRAM_WEBHOOK_SELF_HEAL=true
OPS_RECORDS_DROP_ALERT_MIN=12
SCHEDULE_SYNC_MIN_DAYS=15

# Optional, only for browser web push channel
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
